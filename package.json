{
  "name": "parkpredict",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,html,json,md}\" \"backend/**/*.md\" \"docs/**/*.md\" \"firmware/**/*.md\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,html,json,md}\" \"backend/**/*.md\" \"docs/**/*.md\" \"firmware/**/*.md\" \".github/**/*.yml\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "typescript": "~5.6.2",
    "vite": "^6.0.1"
  }
}
