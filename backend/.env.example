# Replace with long random secrets. Device ID and token are sent in the WebSocket auth message.
IOT_DEVICE_TOKENS={"esp32-demo-01":"replace-with-a-long-random-device-token"}
# RFID UID to demo-only label. Unknown tags can still indicate occupancy.
RFID_TAG_MAP={"A1B2C3D4":"Toy Car 01","11223344":"Toy Car 02"}
IOT_STALE_AFTER_SECONDS=12
# Technician demo sign-in. Keep these values only on the gateway; never use VITE_ variables.
PARKING_ADMIN_USERNAME=replace-with-a-technician-username
PARKING_ADMIN_PASSWORD=replace-with-a-long-random-password
PARKING_ADMIN_SIGNING_KEY=replace-with-a-separate-long-random-signing-key
IOT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
