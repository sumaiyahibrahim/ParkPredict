# Optional: use a commercial tile/geocoding provider in production.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
VITE_SATELLITE_TILE_URL=
VITE_SATELLITE_ATTRIBUTION=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only integrations belong in the backend environment, never VITE_ vars:
MAPTILER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PARKING_OPERATOR_API_URL=
PARKING_OPERATOR_API_KEY=
# IoT prototype: device tokens are configured in backend/.env, never VITE_ variables.
VITE_IOT_WS_URL=ws://localhost:8000/ws/live
VITE_IOT_FACILITY_ID=demo:white-town
# Optional URL for the FastAPI IoT gateway admin API; defaults to the current host on port 8000.
VITE_IOT_API_URL=http://localhost:8000
